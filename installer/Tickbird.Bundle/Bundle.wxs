<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle
    Name="Tickbird"
    Manufacturer="Cymatic Labs"
    Version="$(ProductVersion)"
    UpgradeCode="39EFC1E1-114F-4EA4-A3BA-E4BC4447F36E"
    IconSourceFile="$(IconPath)"
    HelpUrl="https://github.com/sadaqatbukhari/Tickbird">

    <BootstrapperApplication>
      <bal:WixInternalUIBootstrapperApplication Theme="standard" LogoFile="$(LogoPath)" />
    </BootstrapperApplication>

    <Chain>
      <MsiPackage
        Id="TickbirdMsi"
        SourceFile="$(MsiPath)"
        Compressed="yes"
        Vital="yes"
        Visible="no"
        bal:PrimaryPackageType="default" />
    </Chain>
  </Bundle>
</Wix>
