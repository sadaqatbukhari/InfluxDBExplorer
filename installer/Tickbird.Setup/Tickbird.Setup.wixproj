<Project Sdk="WixToolset.Sdk/5.0.2">
  <Import Project="..\..\Version.props" />
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>Tickbird-$(Version)-win-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion>$(Version)</ProductVersion>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\artifacts\publish\win-x64</PublishDir>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\installer\</OutputPath>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir)</DefineConstants>
    <SuppressIces>ICE69</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

  <Target Name="PublishApplication" BeforeTargets="BeforeBuild">
    <MSBuild
      Projects="$(MSBuildThisFileDirectory)..\..\src\Tickbird.Desktop\Tickbird.Desktop.csproj"
      Targets="Restore;Publish"
      Properties="Configuration=Release;RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=false;PublishTrimmed=false;DebugSymbols=false;DebugType=None;PublishDir=$(PublishDir)\" />
  </Target>
</Project>
