<?xml version="1.0" encoding="utf-8"?>
<!--
  InfluxQL language definition (InfluxDB 1.x). Used by the query editor for IntelliSense (Ctrl+Space)
  and syntax colors. Keyword entries may be several words ("SHOW TAG KEYS"); functions are offered as NAME().
  Single-word keywords are also treated as reserved: identifiers with those names are inserted in double quotes.
-->
<ConfigLanguage name="InfluxQL" StartComment="--" CaseInsensitive="true">
  <Extensions>
    <Extension>.influxql</Extension>
    <Extension>.flux</Extension>
  </Extensions>

  <Formats>
    <Format Name="KeyWord" Color="Blue" Bold="true" />
    <Format Name="Function" Color="DarkMagenta" Bold="false" />
    <Format Name="String" Color="Red" />
    <Format Name="Comment" Color="Green" Italic="true" />
  </Formats>

  <Lexems>
    <!-- InfluxQL keywords and statements -->
    <Lexem TypeXML="KeyWord" FormatName="KeyWord" BeginBlock="SELECT" />
    <Lexem TypeXML="KeyWord" FormatName="KeyWord" BeginBlock="FROM" />
