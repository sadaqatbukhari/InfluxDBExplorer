<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\Version.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tickbird.Core</RootNamespace>
    <AssemblyName>Tickbird.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8618;CS8625;CS8601;CS8603;CS8604;CS8600;CS8602;CS8765;CS8767</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="InfluxDB.Client" Version="5.1.0" />
    <PackageReference Include="InfluxDB3.Client" Version="1.10.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\InfluxQL.xml" LogicalName="Tickbird.Core.Resources.InfluxQL.xml" />
  </ItemGroup>
</Project>
